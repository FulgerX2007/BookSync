{
  "name": "booksync-extension",
  "version": "0.1.0",
  "private": true,
  "description": "BookSync WebExtension: end-to-end encrypted bookmark sync for Chromium browsers and Firefox.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:e2e": "node build.mjs --e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "npm run build:e2e && playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "check": "tsc --noEmit && eslint . && vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/chrome": "0.3.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "web-ext": "10.7.0"
  }
}
