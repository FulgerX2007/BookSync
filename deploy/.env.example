# Copy to deploy/.env and adjust. Compose reads it for both variable
# substitution and the booksync container's environment.

# Public DNS name of your server. Caddy gets a TLS certificate for it.
BOOKSYNC_DOMAIN=booksync.example.com

# Run a released image instead of building from source; then use
# `docker compose pull booksync` and `up -d --no-build`.
#BOOKSYNC_IMAGE=ghcr.io/fulgerx2007/booksync-server:0.1.0

# Host ports Caddy listens on.
#BOOKSYNC_HTTP_PORT=80
#BOOKSYNC_HTTPS_PORT=443

# Allow new accounts. Set to false once your accounts exist: there are no
# per-user quotas, so an open server lets anyone store vaults on it.
BOOKSYNC_ALLOW_REGISTRATION=true

# Maximum size of one encrypted vault upload, in bytes (default 10 MiB).
#BOOKSYNC_MAX_VAULT_BYTES=10485760

# History kept per user: the newest N versions...
#BOOKSYNC_VAULT_KEEP_RECENT=10
# ...plus the newest version of each day for this many days (0 disables).
#BOOKSYNC_VAULT_KEEP_DAYS=30

# Device tokens expire after this much inactivity (Go duration).
#BOOKSYNC_TOKEN_TTL=2160h

# debug, info, warn or error.
#BOOKSYNC_LOG_LEVEL=info

# Set by docker-compose.yml; only change if you replace Caddy with another proxy.
#BOOKSYNC_TRUST_PROXY_HEADERS=true

# Listen address and database path inside the container; normally leave as is.
#BOOKSYNC_ADDR=:8080
#BOOKSYNC_DB_PATH=/data/booksync.db
